# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
build/
dist/

# Environment variables - NEVER commit these
.env
.env.*
!.env.example
backend/.env
backend/.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Uploads (user-generated files — do not commit)
backend/uploads/*
!backend/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Testing
coverage/

# Backend dependencies
backend/node_modules/
backend/scratch/

# Dev/fix scripts (not needed by client)
fix.js
fix_*.js
check.js

# SQL backups (too large, sensitive)
*.sql
crm_jot_backup.sql

# PDFs and raw text
*.pdf
*.txt

# Root package files (not part of the app)
package.json
package-lock.json
scripts/
